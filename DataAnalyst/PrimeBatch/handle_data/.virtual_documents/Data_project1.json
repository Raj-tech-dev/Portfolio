import json


def load_data(filename):
    with open(filename) as f:
        data = json.load(f)
    return data


data = load_data("Data_project_p1.json")
print(data, type(data))


for data1 in data:
    print(data1)



clean_data = []

for row in data:
    new_row = row.copy()   # dictionary copy

    try:
        new_row["age"] = int(row["age"])
    except:
        new_row["age"] = None

    clean_data.append(new_row)

data[:] = clean_data




for row in data:
    print(row)


valid_age = [x for x in clean_data if x is not None]


n = len(valid_age)


print(n)


if (n%2==0):
    print("even term")
else:
    print("odd term")


median =valid_age[n//2]
print(median)


final_age = []
for age in clean_data:
    if age is None:
        final_age.append(median)
    else:
        final_age.append(age)



for row in data:
    if row["name"] == "" or row["name"] is None:
        row["name"] = "unknown"
    print(row["name"])






